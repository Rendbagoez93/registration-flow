# Django Core Settings
COMMON_SECRET_KEY=django-insecure-change-this-in-production
COMMON_DEBUG=True
COMMON_ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production only; comma-separated, scheme-included origins (e.g. https://example.com)
COMMON_CSRF_TRUSTED_ORIGINS=

# Environment: local | test | production
COMMON_ENVIRONMENT=local

# Application Settings
COMMON_LOG_LEVEL=INFO
COMMON_TIME_ZONE=Asia/Jakarta
COMMON_LANGUAGE_CODE=en-us

# Email
COMMON_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
COMMON_EMAIL_HOST=localhost
COMMON_EMAIL_PORT=587
COMMON_EMAIL_USE_TLS=True
COMMON_EMAIL_HOST_USER=
COMMON_EMAIL_HOST_PASSWORD=

# Database (default alias)
# ENGINE is auto-selected by COMMON_ENVIRONMENT (sqlite for local/test, postgres for production).
# The values below are only used when the postgres engine is active.
DATABASE_DEFAULT_HOST=localhost
DATABASE_DEFAULT_PORT=5432
DATABASE_DEFAULT_NAME=registration_flow
DATABASE_DEFAULT_USER=postgres
DATABASE_DEFAULT_PASSWORD=change-this-password

